# Societix — local environment configuration TEMPLATE.
#
# Copy this file to `.env` (which is git-ignored) and fill in local values:
#     cp .env.example .env
#
# docker-compose loads `.env` automatically. This template documents EVERY variable the
# local stack understands, with SAFE PLACEHOLDER values only.
#
# SECRETS POLICY (Req 17.5): never commit real credentials or keys. `.env` is ignored by
# git; only this `.env.example` (placeholders only) is tracked. Replace every CHANGE_ME
# value before using in anything beyond throwaway local dev.

# =============================================================================
# Published host ports (left-hand side of the compose "host:container" mappings)
# =============================================================================
POSTGRES_PORT=5432
APP_PORT=8080
FRONTEND_PORT=5173
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# =============================================================================
# Spring profile
# =============================================================================
# local | test | prod — controls backend config (see backend application.yml).
SPRING_PROFILES_ACTIVE=local

# =============================================================================
# Database — PostgreSQL
# =============================================================================
# Superuser/owner of the Postgres container. LOCAL DEV ONLY: used to create the database
# and to run the role-bootstrap init script (infra/db-init). Real environments provision
# roles out of band (infra/README.md) and never serve traffic as the superuser.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_local_only
POSTGRES_DB=societix

# Application RUNTIME datasource. The app connects as a NON-SUPERUSER role that is NOT a
# BYPASSRLS role (infra/README.md "Database roles and Row-Level Security"): PostgreSQL
# silently skips all RLS policies for superusers and BYPASSRLS roles, which would turn the
# tenant-isolation backstop (task 8.2) inert and make a single missed tenant predicate a
# silent cross-tenant leak. The init script creates this role as NOSUPERUSER NOBYPASSRLS.
# Host is the compose service name `postgres` (not localhost) from inside the network.
SOCIETIX_DB_URL=jdbc:postgresql://postgres:5432/societix
SOCIETIX_DB_USERNAME=societix_app
SOCIETIX_DB_PASSWORD=CHANGE_ME_app_db_password

# =============================================================================
# Email — SMTP (captured locally by MailHog, Req A4)
# =============================================================================
# In local dev these point at the `mailhog` service, which accepts mail without auth/TLS
# and exposes a web inbox at http://localhost:${MAILHOG_UI_PORT}. In real environments set
# these to the SMTP provider; credentials come from the secret store, never source control.
SOCIETIX_MAIL_HOST=mailhog
SOCIETIX_MAIL_PORT=1025
SOCIETIX_MAIL_USERNAME=
SOCIETIX_MAIL_PASSWORD=
SOCIETIX_MAIL_SMTP_AUTH=false
SOCIETIX_MAIL_SMTP_STARTTLS=false

# =============================================================================
# File storage (design "File Storage Strategy", Req 17.6)
# =============================================================================
# `filesystem` stores uploads on a local volume (dev); use an S3-compatible object store in
# prod. Files live OUTSIDE the web-executable path. LOCATION is the base directory (dev);
# BUCKET is the object-store bucket name (prod, blank for filesystem).
SOCIETIX_STORAGE_PROVIDER=filesystem
SOCIETIX_STORAGE_LOCATION=/var/societix/files
SOCIETIX_STORAGE_BUCKET=

# =============================================================================
# Session / cookie settings (design ADR-3)
# =============================================================================
# SECURE=false for local http dev; MUST be true behind TLS in prod (Req 17.8, A7).
# SAMESITE: Lax | Strict | None. Idle session timeout in minutes.
SOCIETIX_SESSION_COOKIE_SECURE=false
SOCIETIX_SESSION_COOKIE_SAMESITE=Lax
SOCIETIX_SESSION_TIMEOUT_MINUTES=30

# =============================================================================
# MFA secret-encryption key (Req 24.4, 17.5)
# =============================================================================
# Encrypts TOTP secrets at rest. REQUIRED — the app will not start without it (no safe
# default). Generate a strong random key, e.g. a base64-encoded 256-bit value:
#     openssl rand -base64 32
# Treat this like any production secret: rotate via the secret store, never commit it.
SOCIETIX_MFA_ENCRYPTION_KEY=CHANGE_ME_base64_32_byte_key

# =============================================================================
# Frontend (Vite dev server)
# =============================================================================
# Origin the Vite /api proxy forwards to (vite.config.ts). Inside compose this is the `app`
# service; running Vite directly on the host it is http://localhost:8080.
VITE_BACKEND_ORIGIN=http://app:8080
